/* LUMINOSITY SECTION */
.luminosity-pills {
	display: flex;
	align-items: center;
}

	.font-large .luminosity-pills,
	.font-medium .luminosity-pills {
		font-size: 11px;
	}


.luminosity-pills > .pills-group {
	display: grid;
	grid-template-columns: repeat(10, 1fr);
	grid-gap: 1%;
	width: 100%;
	min-width: 0;
	min-height: 0;
	overflow:hidden;
}

.luminosity-pills .all-pill {
	grid-row-start: span 3;
}


