<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ExtensionBundleId="com.thefella.panel" ExtensionBundleVersion="1.0" ExtensionBundleName="TheFella Panel">
	<Author><![CDATA[Conor MacNeill]]></Author>
	<Abstract><![CDATA[Test Panel]]></Abstract>

    <ExtensionList>
        <Extension Id="com.thefella.panel" Version="1.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="PHSP" Version="14.0" />
            <Host Name="PHXS" Version="14.0" />
        </HostList>
        <LocaleList>
                    <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="4.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.thefella.panel">
            <DispatchInfo >
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <!--<ScriptPath>./jsxbin/init.jsxbin</ScriptPath>-->
                    <ScriptPath>./jsx/init.jsx</ScriptPath>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>TheFella Panel</Menu>
                    <Geometry>
                        <Size>
                            <Height>440</Height>
                            <Width>300</Width>
                        </Size>
                        <MinSize>
                            <Height>420</Height>
                            <Width>252</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>480</Height>
                            <Width>350</Width>
                        </MaxSize>
                    </Geometry>
					<Icons>
						<Icon Type="Normal">./img/icon-light-theme.png</Icon>
						<Icon Type="DarkNormal">./img/icon-dark-theme.png</Icon>
					</Icons>
				</UI>
			</DispatchInfo>
		</Extension>
	</DispatchInfoList>
</ExtensionManifest>